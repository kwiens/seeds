# Neon PostgreSQL. Do not paste Production credentials here.
# Run: pnpm env:setup
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Break glass only. Never set this in Development or Preview.
ALLOW_PRODUCTION_DATABASE=false

# NextAuth.js. env:setup generates a machine-only value locally.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Playwright only. The runner generates the secret and enables this provider.
E2E_TEST_AUTH_ENABLED=false
E2E_TEST_AUTH_SECRET=

# Mapbox
NEXT_PUBLIC_MAPBOX_TOKEN=

# Admin emails (comma-separated, auto-promoted to admin on sign-in)
ADMIN_EMAILS=

# Google Gemini (AI image generation)
GOOGLE_GENERATIVE_AI_API_KEY=

# Vercel Blob (public image storage)
BLOB_READ_WRITE_TOKEN=

# Vercel Blob (separate private store for Team files)
TEAM_FILES_BLOB_READ_WRITE_TOKEN=
